###############################################################################
# Airbnb Clone API — toutes les routes, testables depuis VS Code
# (extension REST Client ou httpYac : cliquer sur "Send Request").
#
# Prérequis : symfony serve -d   +   bin/console doctrine:fixtures:load
#
# Les ids changent à chaque rechargement des fixtures (SQLite ne réutilise pas
# les anciens ids) : ils sont donc lus dans les réponses précédentes via
# "# @name". Exécuter "amenities" et "listings" avant les requêtes qui en dépendent.
#
# Lecture (GET) : publique. Création / modification / suppression : il faut un
# token JWT (exécuter "loginHost" avant), et seul l'hôte peut modifier ou
# supprimer son logement. Comptes des fixtures (mot de passe "password") :
#   host@example.com      → hôte du premier logement de la liste
#   traveler@example.com  → n'est l'hôte d'aucun logement
###############################################################################

@baseUrl = http://127.0.0.1:8000
@json = application/json


### Santé de l'API et de la BDD
GET {{baseUrl}}/api/health
Accept: {{json}}


###############################################################################
# ÉQUIPEMENTS (Amenity, relation ManyToMany avec Listing)
###############################################################################

### Liste des équipements (fournit les ids et les slugs utilisés plus bas)
# @name amenities
GET {{baseUrl}}/api/amenities
Accept: {{json}}


###############################################################################
# LISTING — lecture, pagination, filtres
###############################################################################

### Liste paginée (page 1, 20 par défaut)
# @name listings
GET {{baseUrl}}/api/listings
Accept: {{json}}

### Pagination : page 2, 5 logements par page
GET {{baseUrl}}/api/listings?page=2&limit=5
Accept: {{json}}

### Filtre par titre (recherche partielle, insensible à la casse)
GET {{baseUrl}}/api/listings?title=villa
Accept: {{json}}

### Filtre par ville + nombre de voyageurs + prix max
GET {{baseUrl}}/api/listings?city=berlin&guests=2&maxPrice=200
Accept: {{json}}

### Filtre par pays
GET {{baseUrl}}/api/listings?country=portugal
Accept: {{json}}

### Filtre par équipement (slug, cf. /api/amenities)
GET {{baseUrl}}/api/listings?amenity=wifi
Accept: {{json}}

### Filtre par dates : logements sans réservation (en attente ou confirmée) sur la période
GET {{baseUrl}}/api/listings?availableFrom=2026-12-01&availableTo=2027-01-31
Accept: {{json}}

### Filtres combinés + pagination (format de l'énoncé)
GET {{baseUrl}}/api/listings?title=appartement&amenity=wifi&availableFrom=2026-12-20&availableTo=2026-12-27&page=1&limit=3
Accept: {{json}}

### Tri : les mieux notés d'abord (les logements sans avis en dernier)
GET {{baseUrl}}/api/listings?sort=rating&limit=5
Accept: {{json}}

### Tri : du moins cher au plus cher (ou sort=price_desc)
GET {{baseUrl}}/api/listings?sort=price_asc&limit=5
Accept: {{json}}

### Erreur 422 : tri inconnu (rating, price_asc ou price_desc)
GET {{baseUrl}}/api/listings?sort=popularite
Accept: {{json}}

### Erreur 422 : filtre invalide (guests doit être > 0)
GET {{baseUrl}}/api/listings?guests=0
Accept: {{json}}

### Erreur 422 : limit trop grand (max 50)
GET {{baseUrl}}/api/listings?limit=500
Accept: {{json}}

### Erreur 422 : availableFrom sans availableTo
GET {{baseUrl}}/api/listings?availableFrom=2026-12-20
Accept: {{json}}

### Détail d'un logement (avec avis et note moyenne) — exécuter "listings" avant
GET {{baseUrl}}/api/listings/{{listings.response.body.$.items[0].id}}
Accept: {{json}}

### Erreur 404 : logement inexistant
GET {{baseUrl}}/api/listings/999999
Accept: {{json}}


###############################################################################
# AUTHENTIFICATION (JWT)
###############################################################################

### Connexion de l'hôte → renvoie un token JWT
# @name loginHost
POST {{baseUrl}}/api/login_check
Content-Type: {{json}}

{
    "email": "host@example.com",
    "password": "password"
}

### Connexion d'un voyageur (pas hôte du premier logement) → sert à tester le 403
# @name loginTraveler
POST {{baseUrl}}/api/login_check
Content-Type: {{json}}

{
    "email": "traveler@example.com",
    "password": "password"
}

### Test get user : l'utilisateur connecté (exécuter "loginHost" avant)
GET {{baseUrl}}/api/user
Accept: {{json}}
Authorization: Bearer {{loginHost.response.body.$.token}}

### Erreur 401 : get user sans token
GET {{baseUrl}}/api/user
Accept: {{json}}

### Erreur 401 : mauvais mot de passe
POST {{baseUrl}}/api/login_check
Content-Type: {{json}}

{
    "email": "host@example.com",
    "password": "mauvais"
}


###############################################################################
# FOLLOWERS (ManyToMany User <-> User)
# Exécuter "listings", "loginHost" et "loginTraveler" avant.
# L'hôte suivi est l'hôte du premier logement (host@example.com).
###############################################################################

### Le voyageur suit l'hôte → 204 (le refaire ne change rien)
POST {{baseUrl}}/api/users/{{listings.response.body.$.items[0].host.id}}/follow
Authorization: Bearer {{loginTraveler.response.body.$.token}}

### Followers de l'hôte (paginé : total, lastPage, items)
GET {{baseUrl}}/api/users/{{listings.response.body.$.items[0].host.id}}/followers?page=1&limit=10
Accept: {{json}}

### Profil du voyageur connecté (fournit son id pour la requête suivante)
# @name meTraveler
GET {{baseUrl}}/api/user
Accept: {{json}}
Authorization: Bearer {{loginTraveler.response.body.$.token}}

### Utilisateurs suivis par le voyageur
GET {{baseUrl}}/api/users/{{meTraveler.response.body.$.id}}/following
Accept: {{json}}

### Le voyageur ne suit plus l'hôte → 204
DELETE {{baseUrl}}/api/users/{{listings.response.body.$.items[0].host.id}}/follow
Authorization: Bearer {{loginTraveler.response.body.$.token}}

### Erreur 422 : l'hôte essaie de se suivre lui-même
POST {{baseUrl}}/api/users/{{listings.response.body.$.items[0].host.id}}/follow
Accept: {{json}}
Authorization: Bearer {{loginHost.response.body.$.token}}

### Erreur 401 : suivre sans être connecté
POST {{baseUrl}}/api/users/{{listings.response.body.$.items[0].host.id}}/follow
Accept: {{json}}

### Erreur 404 : suivre un utilisateur inexistant
POST {{baseUrl}}/api/users/999999/follow
Accept: {{json}}
Authorization: Bearer {{loginTraveler.response.body.$.token}}

### Erreur 422 : pagination invalide (limit entre 1 et 50)
GET {{baseUrl}}/api/users/{{listings.response.body.$.items[0].host.id}}/followers?limit=0
Accept: {{json}}


###############################################################################
# AVIS / NOTES (1 à 5 étoiles)
# Exécuter "listings", "loginHost" et "loginTraveler" avant, puis dans l'ordre.
# Les fixtures garantissent que traveler@example.com a terminé un séjour
# confirmé dans le premier logement (hôte : host@example.com) sans l'avoir noté.
###############################################################################

### Fil des derniers avis (tous logements, du plus récent au plus ancien, paginé)
GET {{baseUrl}}/api/reviews?page=1&limit=10
Accept: {{json}}

### Mon fil : les avis des personnes que je suis (connecté)
GET {{baseUrl}}/api/feed?page=1&limit=10
Accept: {{json}}
Authorization: Bearer {{loginTraveler.response.body.$.token}}

### Erreur 401 : mon fil sans être connecté
GET {{baseUrl}}/api/feed
Accept: {{json}}

### Le voyageur note le premier logement → 201
# @name myReview
POST {{baseUrl}}/api/listings/{{listings.response.body.$.items[0].id}}/reviews
Content-Type: {{json}}
Accept: {{json}}
Authorization: Bearer {{loginTraveler.response.body.$.token}}

{
    "rating": 4,
    "comment": "Logement très propre et hôte aux petits soins."
}

### Liste des logements connecté : chaque logement a "myRating" (ma note, ou null)
GET {{baseUrl}}/api/listings?limit=3
Accept: {{json}}
Authorization: Bearer {{loginTraveler.response.body.$.token}}

### Modifier son avis → 200
PUT {{baseUrl}}/api/reviews/{{myReview.response.body.$.id}}
Content-Type: {{json}}
Accept: {{json}}
Authorization: Bearer {{loginTraveler.response.body.$.token}}

{
    "rating": 5,
    "comment": "Finalement : parfait, je recommande !"
}

### Erreur 409 : noter une deuxième fois le même logement
POST {{baseUrl}}/api/listings/{{listings.response.body.$.items[0].id}}/reviews
Content-Type: {{json}}
Accept: {{json}}
Authorization: Bearer {{loginTraveler.response.body.$.token}}

{
    "rating": 1,
    "comment": "Deuxième avis"
}

### Erreur 403 : l'hôte note son propre logement
POST {{baseUrl}}/api/listings/{{listings.response.body.$.items[0].id}}/reviews
Content-Type: {{json}}
Accept: {{json}}
Authorization: Bearer {{loginHost.response.body.$.token}}

{
    "rating": 5,
    "comment": "Mon logement est le meilleur"
}

### Erreur 403 : un autre utilisateur modifie l'avis
PUT {{baseUrl}}/api/reviews/{{myReview.response.body.$.id}}
Content-Type: {{json}}
Accept: {{json}}
Authorization: Bearer {{loginHost.response.body.$.token}}

{
    "rating": 1,
    "comment": "Piraté"
}

### Erreur 403 : un autre utilisateur supprime l'avis
DELETE {{baseUrl}}/api/reviews/{{myReview.response.body.$.id}}
Accept: {{json}}
Authorization: Bearer {{loginHost.response.body.$.token}}

### Erreur 422 : note hors limites (1 à 5) et commentaire vide
POST {{baseUrl}}/api/listings/{{listings.response.body.$.items[0].id}}/reviews
Content-Type: {{json}}
Accept: {{json}}
Authorization: Bearer {{loginTraveler.response.body.$.token}}

{
    "rating": 9,
    "comment": ""
}

### Erreur 401 : noter sans être connecté
POST {{baseUrl}}/api/listings/{{listings.response.body.$.items[0].id}}/reviews
Content-Type: {{json}}
Accept: {{json}}

{
    "rating": 4,
    "comment": "Anonyme"
}

### Supprimer son avis → 204 (remet les données dans leur état initial)
DELETE {{baseUrl}}/api/reviews/{{myReview.response.body.$.id}}
Authorization: Bearer {{loginTraveler.response.body.$.token}}


###############################################################################
# RÉSERVATIONS
# Exécuter "listings", "loginHost" et "loginTraveler" avant, puis dans l'ordre.
# Les dates sont calculées (dans 300 jours) pour être toujours dans le futur et libres.
# Cycle de vie : pending → confirmed (par l'hôte) ; annulable avant l'arrivée.
###############################################################################

### Le voyageur réserve 3 nuits dans le premier logement → 201 (prix calculé par le serveur)
# @name myBooking
POST {{baseUrl}}/api/listings/{{listings.response.body.$.items[0].id}}/bookings
Content-Type: {{json}}
Accept: {{json}}
Authorization: Bearer {{loginTraveler.response.body.$.token}}

{
    "arrivalDate": "{{$datetime "YYYY-MM-DD" 300 d}}",
    "departureDate": "{{$datetime "YYYY-MM-DD" 303 d}}",
    "guests": 1
}

### Mes voyages (réservations du voyageur connecté, paginé)
GET {{baseUrl}}/api/bookings?page=1&limit=10
Accept: {{json}}
Authorization: Bearer {{loginTraveler.response.body.$.token}}

### Détail d'une réservation (voyageur ou hôte)
GET {{baseUrl}}/api/bookings/{{myBooking.response.body.$.id}}
Accept: {{json}}
Authorization: Bearer {{loginTraveler.response.body.$.token}}

### Réservations du logement, vues par son hôte
GET {{baseUrl}}/api/listings/{{listings.response.body.$.items[0].id}}/bookings
Accept: {{json}}
Authorization: Bearer {{loginHost.response.body.$.token}}

### Erreur 403 : le voyageur essaie de confirmer sa propre réservation
POST {{baseUrl}}/api/bookings/{{myBooking.response.body.$.id}}/confirm
Accept: {{json}}
Authorization: Bearer {{loginTraveler.response.body.$.token}}

### L'hôte confirme la réservation → status "confirmed"
POST {{baseUrl}}/api/bookings/{{myBooking.response.body.$.id}}/confirm
Accept: {{json}}
Authorization: Bearer {{loginHost.response.body.$.token}}

### Erreur 409 : confirmer une réservation déjà confirmée
POST {{baseUrl}}/api/bookings/{{myBooking.response.body.$.id}}/confirm
Accept: {{json}}
Authorization: Bearer {{loginHost.response.body.$.token}}

### Erreur 409 : réserver des dates déjà prises
POST {{baseUrl}}/api/listings/{{listings.response.body.$.items[0].id}}/bookings
Content-Type: {{json}}
Accept: {{json}}
Authorization: Bearer {{loginTraveler.response.body.$.token}}

{
    "arrivalDate": "{{$datetime "YYYY-MM-DD" 300 d}}",
    "departureDate": "{{$datetime "YYYY-MM-DD" 303 d}}",
    "guests": 1
}

### Erreur 403 : l'hôte réserve son propre logement
POST {{baseUrl}}/api/listings/{{listings.response.body.$.items[0].id}}/bookings
Content-Type: {{json}}
Accept: {{json}}
Authorization: Bearer {{loginHost.response.body.$.token}}

{
    "arrivalDate": "{{$datetime "YYYY-MM-DD" 300 d}}",
    "departureDate": "{{$datetime "YYYY-MM-DD" 303 d}}",
    "guests": 1
}

### Erreur 403 : le voyageur consulte les réservations d'un logement qui n'est pas le sien
GET {{baseUrl}}/api/listings/{{listings.response.body.$.items[0].id}}/bookings
Accept: {{json}}
Authorization: Bearer {{loginTraveler.response.body.$.token}}

### Erreur 422 : dates dans le passé / départ avant l'arrivée, trop de voyageurs
POST {{baseUrl}}/api/listings/{{listings.response.body.$.items[0].id}}/bookings
Content-Type: {{json}}
Accept: {{json}}
Authorization: Bearer {{loginTraveler.response.body.$.token}}

{
    "arrivalDate": "2020-01-10",
    "departureDate": "2020-01-05",
    "guests": 0
}

### Erreur 401 : réserver sans être connecté
POST {{baseUrl}}/api/listings/{{listings.response.body.$.items[0].id}}/bookings
Content-Type: {{json}}
Accept: {{json}}

{
    "arrivalDate": "{{$datetime "YYYY-MM-DD" 300 d}}",
    "departureDate": "{{$datetime "YYYY-MM-DD" 303 d}}",
    "guests": 1
}

### Le voyageur annule sa réservation → status "cancelled" (les dates redeviennent libres)
POST {{baseUrl}}/api/bookings/{{myBooking.response.body.$.id}}/cancel
Accept: {{json}}
Authorization: Bearer {{loginTraveler.response.body.$.token}}

### Erreur 409 : annuler une réservation déjà annulée
POST {{baseUrl}}/api/bookings/{{myBooking.response.body.$.id}}/cancel
Accept: {{json}}
Authorization: Bearer {{loginTraveler.response.body.$.token}}


###############################################################################
# PHOTOS (envoi de fichier, multipart/form-data, champ "photo")
# Exécuter "listings" et "loginHost" avant, puis dans l'ordre.
# JPEG, PNG ou WebP, 5 Mo max, 10 photos max par logement ; la première est la couverture.
###############################################################################

### L'hôte ajoute une photo à son logement → 201 { id, url }
# @name photo1
POST {{baseUrl}}/api/listings/{{listings.response.body.$.items[0].id}}/photos
Accept: {{json}}
Authorization: Bearer {{loginHost.response.body.$.token}}
Content-Type: multipart/form-data; boundary=EscaleBoundary

--EscaleBoundary
Content-Disposition: form-data; name="photo"; filename="villa.jpg"
Content-Type: image/jpeg

< ./data/photos/villa/villa-01.jpg
--EscaleBoundary--

### Deuxième photo → 201
# @name photo2
POST {{baseUrl}}/api/listings/{{listings.response.body.$.items[0].id}}/photos
Accept: {{json}}
Authorization: Bearer {{loginHost.response.body.$.token}}
Content-Type: multipart/form-data; boundary=EscaleBoundary

--EscaleBoundary
Content-Disposition: form-data; name="photo"; filename="villa.jpg"
Content-Type: image/jpeg

< ./data/photos/villa/villa-01.jpg
--EscaleBoundary--

### La photo est servie directement par le serveur web
GET {{baseUrl}}{{photo1.response.body.$.url}}

### Le logement affiche ses photos ("photos") et sa couverture ("coverUrl")
GET {{baseUrl}}/api/listings/{{listings.response.body.$.items[0].id}}
Accept: {{json}}

### La deuxième photo devient la couverture → renvoie les photos dans le nouvel ordre
POST {{baseUrl}}/api/photos/{{photo2.response.body.$.id}}/cover
Accept: {{json}}
Authorization: Bearer {{loginHost.response.body.$.token}}

### Erreur 422 : un fichier qui n'est pas une image
POST {{baseUrl}}/api/listings/{{listings.response.body.$.items[0].id}}/photos
Accept: {{json}}
Authorization: Bearer {{loginHost.response.body.$.token}}
Content-Type: multipart/form-data; boundary=EscaleBoundary

--EscaleBoundary
Content-Disposition: form-data; name="photo"; filename="README.md"
Content-Type: text/markdown

< ./README.md
--EscaleBoundary--

### Erreur 422 : aucun fichier envoyé
POST {{baseUrl}}/api/listings/{{listings.response.body.$.items[0].id}}/photos
Accept: {{json}}
Authorization: Bearer {{loginHost.response.body.$.token}}

### Erreur 403 : un voyageur ajoute une photo au logement d'un autre
POST {{baseUrl}}/api/listings/{{listings.response.body.$.items[0].id}}/photos
Accept: {{json}}
Authorization: Bearer {{loginTraveler.response.body.$.token}}
Content-Type: multipart/form-data; boundary=EscaleBoundary

--EscaleBoundary
Content-Disposition: form-data; name="photo"; filename="villa.jpg"
Content-Type: image/jpeg

< ./data/photos/villa/villa-01.jpg
--EscaleBoundary--

### Supprimer la première photo (et son fichier) → 204
DELETE {{baseUrl}}/api/photos/{{photo1.response.body.$.id}}
Authorization: Bearer {{loginHost.response.body.$.token}}

### Supprimer la deuxième photo (et son fichier) → 204
DELETE {{baseUrl}}/api/photos/{{photo2.response.body.$.id}}
Authorization: Bearer {{loginHost.response.body.$.token}}


###############################################################################
# LISTING — création, modification, suppression (connecté)
# Exécuter "amenities", "listings" et "loginHost" avant, puis dans l'ordre.
###############################################################################

### Créer un logement → 201 + en-tête Location (l'hôte = l'utilisateur connecté)
# @name created
POST {{baseUrl}}/api/listings
Content-Type: {{json}}
Accept: {{json}}
Authorization: Bearer {{loginHost.response.body.$.token}}

{
    "title": "Cabane au bord du lac",
    "description": "Une cabane en bois, au calme, avec vue sur le lac d'Annecy.",
    "priceByNight": 95,
    "city": "Annecy",
    "country": "France",
    "maxGuests": 3,
    "amenityIds": [
        {{amenities.response.body.$[0].id}},
        {{amenities.response.body.$[1].id}}
    ]
}

### Lire le logement créé (public)
GET {{baseUrl}}/api/listings/{{created.response.body.$.id}}
Accept: {{json}}

### Modifier le logement créé (PUT = remplacement complet, équipements compris)
PUT {{baseUrl}}/api/listings/{{created.response.body.$.id}}
Content-Type: {{json}}
Accept: {{json}}
Authorization: Bearer {{loginHost.response.body.$.token}}

{
    "title": "Cabane rénovée au bord du lac",
    "description": "Entièrement rénovée en 2026.",
    "priceByNight": 120.5,
    "city": "Annecy",
    "country": "France",
    "maxGuests": 4,
    "amenityIds": [
        {{amenities.response.body.$[2].id}}
    ]
}

### Erreur 403 : un autre utilisateur tente de modifier le logement (exécuter "loginTraveler" avant)
PUT {{baseUrl}}/api/listings/{{created.response.body.$.id}}
Content-Type: {{json}}
Accept: {{json}}
Authorization: Bearer {{loginTraveler.response.body.$.token}}

{
    "title": "Piraté",
    "description": "x",
    "priceByNight": 1,
    "city": "Annecy",
    "country": "France",
    "maxGuests": 1
}

### Erreur 403 : un autre utilisateur tente de supprimer le logement
DELETE {{baseUrl}}/api/listings/{{created.response.body.$.id}}
Accept: {{json}}
Authorization: Bearer {{loginTraveler.response.body.$.token}}

### Supprimer le logement créé (par son hôte) → 204
DELETE {{baseUrl}}/api/listings/{{created.response.body.$.id}}
Authorization: Bearer {{loginHost.response.body.$.token}}

### Vérifier la suppression → 404
GET {{baseUrl}}/api/listings/{{created.response.body.$.id}}
Accept: {{json}}

### Erreur 401 : créer sans token
POST {{baseUrl}}/api/listings
Content-Type: {{json}}
Accept: {{json}}

{
    "title": "Sans token",
    "description": "x",
    "priceByNight": 50,
    "city": "Lyon",
    "country": "France",
    "maxGuests": 2
}

### Erreur 401 : token invalide
DELETE {{baseUrl}}/api/listings/{{listings.response.body.$.items[0].id}}
Accept: {{json}}
Authorization: Bearer token-bidon

### Erreur 422 : champs manquants ou invalides
POST {{baseUrl}}/api/listings
Content-Type: {{json}}
Accept: {{json}}
Authorization: Bearer {{loginHost.response.body.$.token}}

{
    "title": "",
    "priceByNight": -10
}

### Erreur 422 : équipement inexistant
POST {{baseUrl}}/api/listings
Content-Type: {{json}}
Accept: {{json}}
Authorization: Bearer {{loginHost.response.body.$.token}}

{
    "title": "Logement fantôme",
    "description": "Équipement inconnu.",
    "priceByNight": 50,
    "city": "Lyon",
    "country": "France",
    "maxGuests": 2,
    "amenityIds": [999999]
}

### Erreur 400 : JSON mal formé
POST {{baseUrl}}/api/listings
Content-Type: {{json}}
Accept: {{json}}
Authorization: Bearer {{loginHost.response.body.$.token}}

{ "title": "oubli de l'accolade"

### Erreur 404 : modifier un logement inexistant
PUT {{baseUrl}}/api/listings/999999
Content-Type: {{json}}
Accept: {{json}}
Authorization: Bearer {{loginHost.response.body.$.token}}

{
    "title": "Inexistant",
    "description": "x",
    "priceByNight": 50,
    "city": "Lyon",
    "country": "France",
    "maxGuests": 2
}

### Erreur 409 : l'hôte supprime son logement qui a des réservations
# (le premier logement des fixtures appartient à host@example.com et a des réservations)
DELETE {{baseUrl}}/api/listings/{{listings.response.body.$.items[0].id}}
Accept: {{json}}
Authorization: Bearer {{loginHost.response.body.$.token}}
